// SecureHR pipeline (Section 11.2): every branch and pull request is checked out, scanned for
// secrets, linted, code-scanned, tested, dependency-scanned, built into images and image-scanned.
// Any gate failure stops the build and marks the pull request check red. Builds of main then
// deploy to staging, run the end-to-end tests and the ZAP scan there, and wait for a person to
// approve the promotion to production (stages 11-14).
//
// Every tool runs in its own pinned container on the host Docker engine (Section 11.4), so the
// Jenkins image stays small and tool versions change in one place: the environment block below.
// An area whose folder does not exist yet (for example /frontend before it is merged) is shown as
// skipped rather than failed; once the folder lands, its stages run and gate automatically.

pipeline {
  agent any

  options {
    // The Checkout stage does it explicitly, so it appears as stage 1.
    skipDefaultCheckout()
    timestamps()
    // Upper bound for the whole run; each stage below has its own tighter limit.
    timeout(time: 60, unit: 'MINUTES')
    // A new push to the same pull request replaces the build that is still running.
    disableConcurrentBuilds(abortPrevious: true)
    buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
  }

  environment {
    // Tool images (Section 0.1: exact tags, never "latest").
    GITLEAKS_IMAGE = 'zricethezav/gitleaks:v8.30.1'
    SEMGREP_IMAGE = 'semgrep/semgrep:1.187.0'
    TRIVY_IMAGE = 'aquasec/trivy:0.76.2'
    JDK_IMAGE = 'eclipse-temurin:21.0.13_9-jdk-noble'
    NODE_IMAGE = 'node:22.23.5-alpine3.24'
    PLAYWRIGHT_IMAGE = 'mcr.microsoft.com/playwright:v1.65.1-noble'
    ZAP_IMAGE = 'zaproxy/zap-stable:2.17.0'

    // Stages 11-14 (Section 11.3). The root .env and the end-to-end credentials are mounted into
    // Jenkins as Docker secrets (ci/compose.yaml); they're read from files, never echoed.
    SECUREHR_ENV_FILE = '/run/secrets/securehr_env'
    E2E_ENV_FILE = '/run/secrets/e2e_env'
    ROOT_COMPOSE = 'deploy/compose/compose.yaml'
    STAGING_URL = 'https://staging.securehr.local:8443'
    PRODUCTION_URL = 'https://securehr.local'

    REPORTS = 'reports'
    // Shared caches live in the Jenkins home volume, which every tool container mounts
    // (the Docker Pipeline plugin passes --volumes-from for the Jenkins container).
    MAVEN_USER_HOME = '/var/jenkins_home/.m2'
    MAVEN_ARGS = '-B -ntp -Dmaven.repo.local=/var/jenkins_home/.m2/repository'
    TRIVY_CACHE_DIR = '/var/jenkins_home/.cache/trivy'
    // Builds run side by side and share one Trivy database. One build at a time may update it
    // (exclusive lock) and scans read it under a shared lock, so a scan never reads a database
    // that is being rewritten (a concurrent update crashed Trivy).
    TRIVY_LOCK = '/var/jenkins_home/.cache/trivy.lock'
    NPM_CONFIG_CACHE = '/var/jenkins_home/.npm'
  }

  stages {
    stage('1. Checkout') {
      steps {
        checkout scm
        script {
          // Image tags are the short commit ID; main builds also get "main" (Section 0.11).
          env.IMAGE_TAG = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
          // Tool containers run as the jenkins user; Testcontainers and Trivy need the socket's
          // group to reach the Docker engine. The group differs between Linux and Docker Desktop.
          env.DOCKER_SOCKET_GID = sh(script: 'stat -c %g /var/run/docker.sock', returnStdout: true).trim()
        }
        sh 'mkdir -p "$REPORTS"'
      }
    }

    stage('2. Secrets scan') {
      agent {
        docker {
          image "${GITLEAKS_IMAGE}"
          args '--entrypoint='
          reuseNode true
        }
      }
      options { timeout(time: 10, unit: 'MINUTES') }
      steps {
        // Scans the full history of the commit being built, not only the latest files: a secret
        // that was committed and later deleted is still leaked and must be rotated (TC-PIPE-01).
        // --log-opts=HEAD keeps the scan to this commit's history. Without it gitleaks scans every
        // branch the checkout fetched, so one leaking branch would fail every other build.
        sh '''
          gitleaks git --no-banner --redact --log-opts=HEAD \
            --config ci/scanners/gitleaks.toml \
            --report-format sarif --report-path "$REPORTS/gitleaks.sarif" \
            .
        '''
      }
    }

    // The Maven wrapper is run through sh so the build does not depend on the file's executable
    // bit being set in Git.
    stage('3. Lint and format') {
      parallel {
        stage('Employee API') {
          when { expression { fileExists('backend/pom.xml') } }
          agent { docker { image "${JDK_IMAGE}"; reuseNode true } }
          options { timeout(time: 10, unit: 'MINUTES') }
          steps {
            dir('backend') { sh 'sh ./mvnw spotless:check checkstyle:check' }
          }
        }
        stage('Document API') {
          when { expression { fileExists('docs-api/pom.xml') } }
          agent { docker { image "${JDK_IMAGE}"; reuseNode true } }
          options { timeout(time: 10, unit: 'MINUTES') }
          steps {
            dir('docs-api') { sh 'sh ./mvnw spotless:check checkstyle:check' }
          }
        }
        stage('Frontend') {
          when { expression { fileExists('frontend/package.json') } }
          agent { docker { image "${NODE_IMAGE}"; reuseNode true } }
          options { timeout(time: 10, unit: 'MINUTES') }
          steps {
            dir('frontend') {
              sh '''
                npm ci --no-audit --no-fund
                npx eslint --max-warnings 0 .
                npx prettier --check .
              '''
            }
          }
        }
      }
    }

    stage('4. Code scan') {
      agent {
        docker {
          image "${SEMGREP_IMAGE}"
          args '--entrypoint='
          reuseNode true
        }
      }
      options { timeout(time: 15, unit: 'MINUTES') }
      steps {
        // Gate on high severity only (Semgrep's ERROR level); lower findings stay in the report.
        // HOME points at the build's temp folder because the jenkins user has no home in this image.
        sh '''
          HOME="$WORKSPACE_TMP" semgrep scan --metrics=off --disable-version-check \
            --config p/java --config p/typescript --config p/dockerfile \
            --exclude docs/evidence \
            --sarif --output "$REPORTS/semgrep.sarif" \
            --severity ERROR --error \
            .
        '''
      }
    }

    stage('5. Employee API tests') {
      when { expression { fileExists('backend/pom.xml') } }
      agent {
        docker {
          image "${JDK_IMAGE}"
          args testcontainersArgs()
          reuseNode true
        }
      }
      options { timeout(time: 30, unit: 'MINUTES') }
      environment { TESTCONTAINERS_HOST_OVERRIDE = 'host.docker.internal' }
      steps {
        // Lint already ran in stage 3; verify runs unit, matrix and integration tests and the
        // coverage gate (Section 13.1).
        dir('backend') { sh 'sh ./mvnw verify -Dspotless.check.skip=true -Dcheckstyle.skip=true' }
      }
      post {
        always { publishJavaResults('backend', 'Employee API') }
      }
    }

    stage('6. Document API tests') {
      when { expression { fileExists('docs-api/pom.xml') } }
      agent {
        docker {
          image "${JDK_IMAGE}"
          args testcontainersArgs()
          reuseNode true
        }
      }
      options { timeout(time: 30, unit: 'MINUTES') }
      environment { TESTCONTAINERS_HOST_OVERRIDE = 'host.docker.internal' }
      steps {
        dir('docs-api') { sh 'sh ./mvnw verify -Dspotless.check.skip=true -Dcheckstyle.skip=true' }
      }
      post {
        always { publishJavaResults('docs-api', 'Document API') }
      }
    }

    stage('7. Frontend tests') {
      when { expression { fileExists('frontend/package.json') } }
      agent { docker { image "${NODE_IMAGE}"; reuseNode true } }
      options { timeout(time: 15, unit: 'MINUTES') }
      steps {
        dir('frontend') {
          sh '''
            npm ci --no-audit --no-fund
            npx vitest run --reporter=default --reporter=junit \
              --outputFile.junit="$WORKSPACE/$REPORTS/frontend-junit.xml"
          '''
        }
      }
      post {
        always { junit allowEmptyResults: true, testResults: "${REPORTS}/frontend-junit.xml" }
      }
    }

    stage('8. Dependency scan') {
      agent {
        docker {
          image "${TRIVY_IMAGE}"
          args '--entrypoint='
          reuseNode true
        }
      }
      options { timeout(time: 15, unit: 'MINUTES') }
      steps {
        // Fails on high or critical vulnerabilities that have a fix available (Section 11.2).
        // Accepted findings, each with a reason and an expiry date, are in the ignore file.
        // HOME is the Jenkins home so Trivy reads the Maven cache the test stages filled
        // ($HOME/.m2/repository) instead of fetching every pom from Maven Central, which
        // rate-limits repeated downloads.
        sh '''
          export HOME=/var/jenkins_home
          mkdir -p "$(dirname "$TRIVY_LOCK")"
          flock -x "$TRIVY_LOCK" trivy image --download-db-only --no-progress
          flock -x "$TRIVY_LOCK" trivy image --download-java-db-only --no-progress
          status=0
          flock -s "$TRIVY_LOCK" trivy fs --skip-db-update --skip-java-db-update --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed \
            --ignorefile backend/.trivyignore.yaml \
            --skip-dirs docs/evidence \
            --format json --output "$REPORTS/trivy-fs.json" \
            --exit-code 1 . || status=$?
          trivy convert --format table "$REPORTS/trivy-fs.json"
          trivy convert --format sarif --output "$REPORTS/trivy-fs.sarif" "$REPORTS/trivy-fs.json"
          exit $status
        '''
      }
    }

    stage('9. Build images') {
      options { timeout(time: 20, unit: 'MINUTES') }
      steps {
        script {
          applicationImages().each { img ->
            def tags = "-t ${img.name}:${env.IMAGE_TAG}"
            if (env.BRANCH_NAME == 'main') {
              tags += " -t ${img.name}:main"
            }
            sh "docker build ${tags} ${img.context}"
          }
        }
      }
    }

    stage('10. Image scan') {
      agent {
        docker {
          image "${TRIVY_IMAGE}"
          args "--entrypoint= -v /var/run/docker.sock:/var/run/docker.sock --group-add ${env.DOCKER_SOCKET_GID}"
          reuseNode true
        }
      }
      options { timeout(time: 20, unit: 'MINUTES') }
      steps {
        script {
          // Fails on any high or critical vulnerability in an image (Section 11.2). Each image
          // uses its own folder's ignore file, when the owner has one.
          def failed = []
          sh '''
            mkdir -p "$(dirname "$TRIVY_LOCK")"
            flock -x "$TRIVY_LOCK" trivy image --download-db-only --no-progress
            flock -x "$TRIVY_LOCK" trivy image --download-java-db-only --no-progress
          '''
          applicationImages().each { img ->
            def report = "${env.REPORTS}/trivy-image-${img.context}"
            def ignore = fileExists("${img.context}/.trivyignore.yaml") ? "--ignorefile ${img.context}/.trivyignore.yaml" : ''
            def status = sh(returnStatus: true, script: """
              flock -s "\$TRIVY_LOCK" trivy image --skip-db-update --skip-java-db-update \
                --scanners vuln --severity HIGH,CRITICAL ${ignore} \
                --format json --output ${report}.json --exit-code 1 ${img.name}:${env.IMAGE_TAG}
            """)
            sh """
              trivy convert --format table ${report}.json
              trivy convert --format sarif --output ${report}.sarif ${report}.json
            """
            if (status != 0) {
              failed << img.name
            }
          }
          if (failed) {
            error("Image scan found high or critical vulnerabilities in: ${failed.join(', ')}")
          }
        }
      }
    }

    // ---- Stages 11-14: main only, once the root Compose file exists (Section 11.2) ----------

    stage('11. Deploy staging') {
      when { allOf { branch 'main'; expression { fileExists(env.ROOT_COMPOSE) } } }
      options { timeout(time: 15, unit: 'MINUTES') }
      steps {
        // Staging runs its own edge, ui, api and docs-api from the images just built and scanned
        // (project securehr-staging, port 8443); it shares the identity, secrets, data and log
        // services with production (Section 11.3).
        deployRuntime('securehr-staging', ['-f', 'edge/compose.staging.yaml'])
        waitForHealthy(env.STAGING_URL)
      }
    }

    stage('12. End-to-end tests') {
      when { allOf { branch 'main'; expression { fileExists(env.ROOT_COMPOSE) && fileExists('e2e/package.json') } } }
      agent {
        docker {
          image "${PLAYWRIGHT_IMAGE}"
          args publicHostArgs()
          reuseNode true
        }
      }
      options { timeout(time: 20, unit: 'MINUTES') }
      steps {
        dir('e2e') {
          // Credentials are exported from the secret file into this shell only.
          sh '''
            set +x
            set -a; . "$E2E_ENV_FILE"; set +a
            export HOME="$WORKSPACE_TMP" E2E_TARGET=staging
            npm ci --no-audit --no-fund
            npx playwright test
          '''
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'e2e/reports/junit.xml'
          publishHTML(target: [
            reportName: 'Playwright report',
            reportDir: 'e2e/reports/html',
            reportFiles: 'index.html',
            allowMissing: true,
            keepAll: true,
            alwaysLinkToLastBuild: true,
          ])
        }
      }
    }

    stage('13. Live application scan') {
      when { allOf { branch 'main'; expression { fileExists(env.ROOT_COMPOSE) } } }
      agent {
        docker {
          image "${ZAP_IMAGE}"
          args "--entrypoint= ${publicHostArgs()}"
          reuseNode true
        }
      }
      options { timeout(time: 20, unit: 'MINUTES') }
      steps {
        // ZAP baseline (passive) scan of staging. It fails only on a High-risk alert
        // (Section 11.2); lower alerts are kept in the report for review.
        // ZAP writes its reports to /zap/wrk, which the image expects to be mounted; create it.
        sh '''
          mkdir -p /zap/wrk
          zap-baseline.py -t "$STAGING_URL" -I -m 3 \
            -r zap-report.html -J zap-report.json || true
          mkdir -p "$REPORTS"
          cp /zap/wrk/zap-report.html /zap/wrk/zap-report.json "$REPORTS/"
          python3 - "$REPORTS/zap-report.json" <<'PY'
import json, sys
report = json.load(open(sys.argv[1]))
high = [a for site in report.get("site", []) for a in site.get("alerts", []) if a.get("riskcode") == "3"]
for alert in high:
    print("HIGH:", alert.get("alert"), "-", alert.get("count"), "instance(s)")
print(f"ZAP high-risk alerts: {len(high)}")
sys.exit(1 if high else 0)
PY
        '''
      }
    }

    stage('14. Promote to production') {
      when { allOf { branch 'main'; expression { fileExists(env.ROOT_COMPOSE) } } }
      steps {
        // A person approves every production release (Section 5.5). The build waits up to an
        // hour, then stops without deploying.
        timeout(time: 60, unit: 'MINUTES') {
          input message: "Promote ${env.IMAGE_TAG} to production?", ok: 'Promote', submitter: 'SECUREHR_DEV'
        }
        timeout(time: 15, unit: 'MINUTES') {
          deployRuntime('securehr-prod', [])
          waitForHealthy(env.PRODUCTION_URL)
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: "${REPORTS}/**", allowEmptyArchive: true
      recordIssues(
        enabledForFailure: true,
        skipPublishingChecks: true,
        tools: [
          sarif(id: 'gitleaks', name: 'Secrets (gitleaks)', pattern: "${REPORTS}/gitleaks.sarif"),
          sarif(id: 'semgrep', name: 'Code scan (Semgrep)', pattern: "${REPORTS}/semgrep.sarif"),
          sarif(id: 'trivy-fs', name: 'Dependencies (Trivy)', pattern: "${REPORTS}/trivy-fs.sarif"),
          sarif(id: 'trivy-image', name: 'Images (Trivy)', pattern: "${REPORTS}/trivy-image-*.sarif"),
        ]
      )
    }
    cleanup {
      cleanWs()
    }
  }
}

/**
 * The application images (Section 0.11) whose folders exist on this branch, as maps with the
 * image name and the build context folder.
 */
def applicationImages() {
  def all = [
    [name: 'securehr/api', context: 'backend'],
    [name: 'securehr/docs-api', context: 'docs-api'],
    [name: 'securehr/ui', context: 'frontend'],
    [name: 'securehr/edge', context: 'edge'],
  ]
  return all.findAll { fileExists("${it.context}/Dockerfile") }
}

/**
 * Docker arguments that let Testcontainers inside a tool container start sibling containers on
 * the host engine and reach their mapped ports through host.docker.internal.
 */
def testcontainersArgs() {
  return "-v /var/run/docker.sock:/var/run/docker.sock --group-add ${env.DOCKER_SOCKET_GID} " +
    '--add-host=host.docker.internal:host-gateway'
}

/**
 * Publishes JUnit results (unit and integration) and the JaCoCo coverage report for a Maven area.
 */
def publishJavaResults(String folder, String label) {
  junit allowEmptyResults: true,
    testResults: "${folder}/target/surefire-reports/*.xml, ${folder}/target/failsafe-reports/*.xml"
  recordCoverage(
    id: "coverage-${folder}",
    name: "${label} coverage",
    tools: [[parser: 'JACOCO', pattern: "${folder}/target/site/jacoco/jacoco.xml"]],
    skipPublishingChecks: true
  )
  publishHTML(target: [
    reportName: "${label} coverage report",
    reportDir: "${folder}/target/site/jacoco",
    reportFiles: 'index.html',
    allowMissing: true,
    keepAll: true,
    alwaysLinkToLastBuild: true,
  ])
}

/**
 * Starts the runtime services of a Compose project (edge, ui, api, docs-api, whichever exist on
 * this branch) from the images this build tagged with IMAGE_TAG. Nothing is rebuilt here, so what
 * runs is exactly what stages 9 and 10 built and scanned.
 */
def deployRuntime(String project, List extraFiles) {
  // Jenkins drives the host's Docker engine, so bind-mount paths must be host paths. The only one
  // the runtime services use is the edge's mkcert folder, which is git-ignored and exists only in
  // the host checkout; point it there. Every other file comes from the commit being built.
  writeFile file: 'host-paths.override.yaml', text: """
services:
  edge:
    volumes: !override
      - ${env.SECUREHR_HOST_CHECKOUT}/edge/certs:/etc/nginx/certs:ro
"""
  def files = (['-f', env.ROOT_COMPOSE] + extraFiles + ['-f', 'host-paths.override.yaml']).join(' ')
  def compose = "docker compose -p ${project} --env-file ${env.SECUREHR_ENV_FILE} ${files}"
  def available = sh(script: "${compose} config --services", returnStdout: true).trim().split('\n') as List
  def services = ['edge', 'ui', 'api', 'docs-api'].findAll { available.contains(it) }
  sh "IMAGE_TAG=${env.IMAGE_TAG} ${compose} up -d --no-build --no-deps ${services.join(' ')}"
}

/**
 * Fails the build unless the stack answers through the edge within 3 minutes: the portal page
 * returns 200 and /api/me returns 401, which shows the API is up and checking tokens.
 */
def waitForHealthy(String baseUrl) {
  // -k: the certificate comes from the local mkcert authority, which this container doesn't
  // trust; this checks that the services answer, not TLS (the edge's own tests cover TLS).
  sh """
    for attempt in \$(seq 1 36); do
      portal=\$(curl -ks -o /dev/null -w '%{http_code}' --max-time 5 '${baseUrl}/' || true)
      api=\$(curl -ks -o /dev/null -w '%{http_code}' --max-time 5 '${baseUrl}/api/me' || true)
      echo "attempt \$attempt: portal=\$portal api=\$api"
      if [ "\$portal" = 200 ] && [ "\$api" = 401 ]; then exit 0; fi
      sleep 5
    done
    echo 'Health check failed for ${baseUrl}' >&2
    exit 1
  """
}

/**
 * Docker arguments that make the public hostnames resolve to the host, where the production
 * edge publishes 443 and the staging edge 8443 (Section 0.3).
 */
def publicHostArgs() {
  def domain = env.SECUREHR_DOMAIN ?: 'securehr.local'
  return ['', 'staging.', 'auth.', 'grafana.', 'ci.'].collect { "--add-host=${it}${domain}:host-gateway" }.join(' ')
}
