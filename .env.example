# SecureHR environment template (Section 0.9). Copy to .env at the repository root and fill in.
# .env is git-ignored. Values shown are fixed by Section 0; blank ones are set by each area owner.
# Never commit real values; secrets the APIs use at runtime live in Vault.

# --- All services ---
SECUREHR_DOMAIN=securehr.local
# Short Git commit ID of the images to run (Section 0.11). "dev" for local builds.
IMAGE_TAG=dev

# --- Identity (Keycloak, Section 0.5) ---
KEYCLOAK_ISSUER_URI=https://auth.securehr.local/realms/securehr
API_AUDIENCE=securehr-api
DOCS_AUDIENCE=securehr-docs
PORTAL_CLIENT_ID=securehr-portal
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# --- Directory (LLDAP, Section 0.4) ---
LLDAP_ADMIN_PASSWORD=
LLDAP_JWT_SECRET=

# --- Secrets (Vault, Section 0.7) ---
VAULT_ADDR=
API_VAULT_ROLE_ID=
API_VAULT_SECRET_ID=
DOCS_VAULT_ROLE_ID=
DOCS_VAULT_SECRET_ID=

# --- Employee API database (Section 0.8) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=employees
# First initialization of the mysql-data volume only.
MYSQL_ROOT_PASSWORD=

# --- Document API database and storage ---
DOCS_DB_HOST=docs-db
DOCS_DB_PORT=5432
DOCS_DB_NAME=securehr_docs
# First initialization of the docs-db volume only.
DOCS_DB_ADMIN_PASSWORD=
DOCS_STORAGE_PATH=

# --- Tools (Grafana, Jenkins, smee, Loki) ---
GRAFANA_OIDC_CLIENT_SECRET=
JENKINS_OIDC_CLIENT_SECRET=
GITHUB_WEBHOOK_PROXY_URL=
LOKI_URL=
