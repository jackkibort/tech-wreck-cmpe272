# Security headers on every response, including errors and firewall blocks ("always").
# Section 8.4. Included at server level; locations here never use add_header, so they inherit it.
# The tool UIs (Keycloak, Jenkins, Grafana, LLDAP) set their own Content-Security-Policy and
# framing rules; the portal adds its own in securehr-portal-csp.conf.
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header X-Content-Type-Options    "nosniff" always;
add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
add_header Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
add_header X-Request-ID              $securehr_request_id always;
