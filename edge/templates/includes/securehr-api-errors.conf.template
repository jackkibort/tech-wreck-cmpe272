# Errors the edge itself produces on the portal host are returned in the APIs' error format
# (Section 0.6: status, error, message, requestId), so the UI handles them like API errors.
# error_page here applies only to responses generated by NGINX/ModSecurity, never to upstream ones.
error_page 403 = @securehr_waf_block;
error_page 413 = @securehr_too_large;
error_page 429 = @securehr_rate_limited;
error_page 502 503 504 = @securehr_unavailable;

location @securehr_waf_block {
    default_type application/json;
    return 403 '{"status":403,"error":"Forbidden","message":"The request was blocked by the web application firewall.","requestId":"$securehr_request_id"}';
}

location @securehr_too_large {
    default_type application/json;
    return 413 '{"status":413,"error":"Payload Too Large","message":"Uploads are limited to 10 MB.","requestId":"$securehr_request_id"}';
}

location @securehr_rate_limited {
    default_type application/json;
    add_header Retry-After 10 always;
    include includes/securehr-security-headers.conf;
    include includes/securehr-portal-csp.conf;
    return 429 '{"status":429,"error":"Too Many Requests","message":"Too many requests. Please wait a moment and try again.","requestId":"$securehr_request_id"}';
}

location @securehr_unavailable {
    default_type application/json;
    return 503 '{"status":503,"error":"Service Unavailable","message":"The service is temporarily unavailable.","requestId":"$securehr_request_id"}';
}
