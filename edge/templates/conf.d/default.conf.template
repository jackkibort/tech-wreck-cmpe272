# LLDAP admin UI: directory.securehr.local (requires the LLDAP admin login)
server {
    listen ${SSL_PORT} ssl;
    http2 on;
    server_name ${EDGE_HOST_PREFIX}directory.${SECUREHR_DOMAIN};

    include includes/securehr-security-headers.conf;

    location / {
        limit_req zone=web burst=100 nodelay;
        set $securehr_upstream http://ldap:17170;
        proxy_pass $securehr_upstream;
    }
}
