    {
      "id": 6,
      "type": "timeseries",
      "title": "Sensitive actions over time",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (event_type) (count_over_time({log_type=\"audit\"} | json | event_type=~\"SALARY_READ|EXPORT|DOC_UPLOAD|DOC_DOWNLOAD|DOC_DELETE\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{event_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Sensitive actions by user",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (actor_username) (count_over_time({log_type=\"audit\"} | json | event_type=~\"SALARY_READ|EXPORT|DOC_UPLOAD|DOC_DOWNLOAD|DOC_DELETE\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{actor_username}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Latest sensitive-data events",
      "description": "Every salary view, export and document action (G4). Shows who, whose data, and the request ID to trace it.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{log_type=\"audit\"} | json | event_type=~\"SALARY_READ|EXPORT|DOC_UPLOAD|DOC_DOWNLOAD|DOC_DELETE\" | line_format \"{{.event_type}}  {{.outcome}}  user={{.actor_username}} ({{.actor_emp_no}})  target={{.target_emp_no}}  resource={{.resource}}  request={{.request_id}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
