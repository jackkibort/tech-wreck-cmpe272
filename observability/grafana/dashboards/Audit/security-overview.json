    {
      "id": 11,
      "type": "logs",
      "title": "Latest security events",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{log_type=\"audit\"} | json | event_type=~\"LOGIN_FAILURE|ACCESS_DENIED|WAF_BLOCK|RATE_LIMITED\" | line_format \"{{.event_type}}  user={{.actor_username}}  resource={{.resource}}  ip={{.source_ip}}  outcome={{.outcome}}  request={{.request_id}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
