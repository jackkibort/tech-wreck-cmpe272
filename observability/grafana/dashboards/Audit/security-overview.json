    {
      "id": 5,
      "type": "stat",
      "title": "Account lockouts",
      "description": "Keycloak brute-force lockouts (5 failures, Section 8.3), from Keycloak's event log.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"keycloak\"} |= \"user_temporarily_disabled\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "lockouts"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
